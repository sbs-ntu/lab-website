{
  "name": "lab-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose -f docker-compose.dev.yml up --build -d && docker compose -f docker-compose.dev.yml logs -tf",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:compose": "docker compose -f docker-compose.dev.yml",
    "build": "next build",
    "start": "serve -l 3005 out",
    "prod:up": "docker compose -f docker-compose.prod.yml up --build -d && docker compose -f docker-compose.prod.yml logs -tf",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:compose": "docker compose -f docker-compose.prod.yml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}